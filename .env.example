# LLM 설정 (OpenAI 호환 Chat Completions API)
# 기본값은 로컬 Ollama. OpenAI 등을 쓰려면 아래 3개를 바꾼다.
# openai-compatible | mock
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gpt-oss:20b

# 실행 결과가 쌓이는 폴더 (git에 올리지 않음)
DATA_DIR=data

# true(기본): 외부로 아무것도 보내지 않고 data/outbox.jsonl 에만 기록
DRY_RUN=true

# B. 리드 후속 서버 포트
PORT=3100

# ---------- 공용 엔진 (pnpm engine) ----------
# 운영 AI 모델은 미정. 위 LLM_* 값만 바꾸면 교체된다 (OpenAI 호환 API).
ENGINE_HOST=127.0.0.1
ENGINE_PORT=3200
ENGINE_DB_PATH=data/engine/engine.db
ENGINE_CONFIG_DIR=config
WORKER_INTERVAL_MS=5000
# 운영 API(Bearer)와 승인 화면(Basic 비밀번호)에 쓰는 토큰. 24자 이상: openssl rand -hex 24
ADMIN_TOKEN=
# 서비스별 웹훅 서명 시크릿 (config/services.json 의 webhookSecretEnv). 16자 이상: openssl rand -hex 16
COUPIN_PLUS_WEBHOOK_SECRET=
COUPIN_ON_WEBHOOK_SECRET=
